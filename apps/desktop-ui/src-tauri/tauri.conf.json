{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project ATLAS",
  "version": "0.0.0",
  "identifier": "com.projectatlas.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Project ATLAS",
